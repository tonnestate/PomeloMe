                "ASSERT": "#/$defs/AssertNode",
                "EFFECT": "#/$defs/EffectNode",
                "FILTER": "#/$defs/FilterNode",
                "IF_TYPED": "#/$defs/IfTypedNode",
                "PARALLEL_BOUNDED": "#/$defs/ParallelBoundedNode",
                "READ": "#/$defs/ReadNode",
                "REQUEST_JUDGMENT": "#/$defs/RequestJudgmentNode",
                "RETURN": "#/$defs/ReturnNode",
                "SELECT": "#/$defs/SelectNode"
