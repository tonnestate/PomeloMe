              {
                "$ref": "#/$defs/SelectNode"
              },
              {
                "$ref": "#/$defs/FilterNode"
              },
              {
                "$ref": "#/$defs/AssertNode"
              },
              {
                "$ref": "#/$defs/RequestJudgmentNode"
