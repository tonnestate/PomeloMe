        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "input_ref": {
          "title": "Input Ref",
          "type": "string"
        },
        "max_items": {
          "default": 1000,
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Items",
          "type": "integer"
        },
        "op": {
          "const": "FILTER",
          "default": "FILTER",
          "title": "Op",
          "type": "string"
