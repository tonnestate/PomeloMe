{
  "$defs": {
    "AssertNode": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "$ref": "#/$defs/Condition"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "message": {
          "default": "assertion failed",
          "title": "Message",
          "type": "string"
        },
        "on_fail": {
          "default": "SUSPEND",
          "enum": [
            "SUSPEND",
            "FAIL"
          ],
          "title": "On Fail",
          "type": "string"
        },
        "op": {
          "const": "ASSERT",
          "default": "ASSERT",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "id",
        "condition"
      ],
      "title": "AssertNode",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "left_ref": {
          "title": "Left Ref",
          "type": "string"
        },
        "operator": {
          "enum": [
            "eq",
            "ne",
            "gt",
            "gte",
            "lt",
            "lte",
            "truthy",
            "falsy"
          ],
          "title": "Operator",
          "type": "string"
        },
        "right": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {},
              "type": "array"
            },
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Right"
        }
      },
      "required": [
        "left_ref",
        "operator"
      ],
      "title": "Condition",
      "type": "object"
    },
    "EffectClass": {
      "enum": [
        "READ",
        "IDEMPOTENT_WRITE",
        "COMPENSATABLE",
        "IRREVERSIBLE"
      ],
      "title": "EffectClass",
      "type": "string"
    },
    "EffectNode": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "items": {},
                "type": "array"
              },
              {
                "additionalProperties": true,
