            "oneOf": [
              {
                "$ref": "#/$defs/ReadNode"
              },
              {
                "$ref": "#/$defs/EffectNode"
              },
              {
                "$ref": "#/$defs/SelectNode"
              },
              {
                "$ref": "#/$defs/FilterNode"
              },
              {
                "$ref": "#/$defs/AssertNode"
              },
              {
                "$ref": "#/$defs/RequestJudgmentNode"
              },
              {
                "$ref": "#/$defs/ReturnNode"
              },
              {
                "$ref": "#/$defs/IfTypedNode"
