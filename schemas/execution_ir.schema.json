              {
                "type": "null"
              }
            ]
          },
          "title": "Args",
          "type": "object"
        },
        "effect_class": {
          "$ref": "#/$defs/EffectClass"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        },
        "op": {
          "const": "EFFECT",
          "default": "EFFECT",
          "title": "Op",
          "type": "string"
        },
        "output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output"
        },
        "required_capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Required Capabilities",
          "type": "array",
          "uniqueItems": true
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "id",
        "tool",
        "effect_class"
      ],
      "title": "EffectNode",
      "type": "object"
    },
    "FilterNode": {
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "items": {
            "$ref": "#/$defs/Condition"
